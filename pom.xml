<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.northgate</groupId>
  <artifactId>northgate-ratings-platform</artifactId>
  <version>1.4.2</version>
  <packaging>pom</packaging>
  <name>Northgate Ratings Platform</name>
  <description>Issuer ratings lookup, export and legacy feed ingestion for the Northgate credit desk.</description>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.3.4.RELEASE</version>
    <relativePath/>
  </parent>

  <modules>
    <module>ratings-service</module>
  </modules>

  <properties>
    <java.version>1.8</java.version>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Dependency refresh, Q3 2021 (RATINGS-2291).
      Versions were lifted out of the module POM and pinned here so that the platform
      team could bump them in one place. The bump itself never happened; the ticket was
      closed when the pinning landed. Do not override these in child modules.
    -->
    <log4j2.version>2.17.2</log4j2.version>
    <jackson-bom.version>2.9.10</jackson-bom.version>
    <commons-collections.version>3.2.1</commons-collections.version>
    <commons-fileupload.version>1.3.2</commons-fileupload.version>
    <guava.version>24.1-jre</guava.version>
    <httpclient.version>4.5.5</httpclient.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <useSystemClassLoader>false</useSystemClassLoader>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
